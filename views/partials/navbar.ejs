<nav class="navbar">
    <div class="nav-container">
        <a href="/" class="logo">Smart<span>Hire</span> 🇮🇳</a>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/jobs">Browse Jobs</a></li>
            
            <% if (user) { %>
                <% if (user.role === 'recruiter') { %>
                    <li><a href="/dashboard" style="color: var(--accent-color); font-weight: bold;">Dashboard</a></li>
                <% } %>
                
                <% if (user.role === 'seeker') { %>
                    <li><a href="/my-applications" style="color: var(--accent-color); font-weight: bold;">My Applications</a></li>
                    <li><a href="/profile">Profile</a></li>
                <% } %>
                
                <li style="color: var(--text-muted); font-weight: bold;">Hi, <%= user.name %></li>
                <li><a href="/logout" class="btn-secondary">Logout</a></li>
            <% } else { %>
                <li><a href="/login" class="btn-secondary">Login</a></li>
                <li><a href="/register" class="btn-primary">Register</a></li>
            <% } %>
        </ul>
    </div>
