<%- include('partials/header', { title: 'Register' }) %>
<%- include('partials/navbar') %>

<main class="container" style="max-width: 500px; margin-top: 4rem;">
    <div style="background: white; padding: 2rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
        <h1 style="text-align: center; margin-bottom: 1.5rem; color: var(--primary-color);">Create an Account</h1>
        
        <form action="/register" method="POST" style="display: flex; flex-direction: column; gap: 1rem;">
            <input type="text" name="name" placeholder="Full Name" required style="padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px;">
            <input type="email" name="email" placeholder="Email Address" required style="padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px;">
            <input type="password" name="password" placeholder="Create Password" required style="padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px;">
            
            <select name="role" required style="padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px;">
                <option value="seeker">I am looking for a job (Job Seeker)</option>
                <option value="recruiter">I want to hire (Recruiter)</option>
            </select>
            
            <button type="submit" class="btn-primary" style="margin-top: 0.5rem; cursor: pointer;">Register</button>
        </form>
        
        <p style="text-align: center; margin-top: 1.5rem;">Already have an account? <a href="/login" style="color: var(--accent-color);">Login here</a></p>
    </div>
</main>

<%- include('partials/footer') %>