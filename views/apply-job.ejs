<%- include('partials/header', { title: 'Apply for Job' }) %>
<%- include('partials/navbar') %>

<main class="container" style="max-width: 650px; margin-top: 3rem;">
    <div style="background: white; padding: 2rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
        <h1 style="color: var(--primary-color); font-size: 1.5rem; margin-bottom: 0.5rem;">Submit Application</h1>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
            Applying for <strong><%= job.title %></strong> at <strong><%= job.company %></strong>
        </p>

        <form action="/jobs/<%= job._id %>/apply" method="POST" style="display: flex; flex-direction: column; gap: 1.25rem;">
            
            <!-- Resume Preview -->
            <div style="background: #f8fafc; padding: 1rem; border: 1px solid var(--border-color); border-radius: 6px;">
                <label style="display: block; font-weight: bold; margin-bottom: 0.5rem;">Attached Resume</label>
                <p style="margin: 0; font-size: 0.95rem;">
                    📄 <a href="<%= user.resume %>" target="_blank" style="color: var(--accent-color); font-weight: bold; text-decoration: none;">View Attached Resume</a>
                </p>
                <small style="color: var(--text-muted);">To update your resume, go to your <a href="/profile">Profile</a> prior to submitting.</small>
            </div>

            <!-- GitHub Profile or Portfolio Link -->
            <div>
                <label style="display: block; font-weight: bold; margin-bottom: 0.25rem;">GitHub / Portfolio URL (Optional)</label>
                <input type="url" name="githubUrl" placeholder="https://github.com/yourusername" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px;">
            </div>

            <!-- Cover Letter -->
            <div>
                <label style="display: block; font-weight: bold; margin-bottom: 0.25rem;">Cover Letter / Short Introduction (Optional)</label>
                <textarea name="coverLetter" rows="4" placeholder="Briefly explain why you are a good fit for this role..." style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px;"></textarea>
            </div>

            <button type="submit" class="btn-primary" style="padding: 0.85rem; cursor: pointer; font-size: 1rem;">Confirm & Submit Application</button>
        </form>
    </div>
</main>

<%- include('partials/footer') %>